+<body>
+<div class="window">
+  <div class="title">Windows 95 - v86 에뮬레이터</div>
+  <div class="toolbar">
+    <label>부팅 이미지 <input id="disk" type="file" accept=".img,.ima,.bin,.iso,.hdd"></label>
+    <button id="boot">부팅</button>
+    <button id="stop">정지</button>
+    <button id="reset">재시작</button>
+  </div>
+  <div id="screen"><div style="color:#fff">Windows 95 IMG 파일을 선택한 뒤 부팅을 누르세요.</div></div>
+  <div class="note">주의: 설치 CD(ISO)가 아니라 부팅 가능한 Windows 95 하드디스크 이미지가 필요할 수 있습니다.</div>
+</div>
+<script>
+let emulator=null;
+const screen=document.getElementById('screen');
+const fileInput=document.getElementById('disk');
+function stop(){if(emulator){try{emulator.stop()}catch(e){} emulator=null;}}
+async function boot(){
