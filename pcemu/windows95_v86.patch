+body{margin:0;background:#008080;font-family:Arial,sans-serif;color:#000;display:flex;align-items:center;justify-content:center;min-height:100vh}
+.window{width:min(960px,96vw);background:#c0c0c0;border:2px solid #fff;box-shadow:2px 2px #000}
+.title{background:#000080;color:#fff;font-weight:bold;padding:5px 8px}
+.toolbar{padding:8px;display:flex;gap:8px;flex-wrap:wrap;align-items:center}
+button,input{font:inherit}button{padding:4px 12px;border:2px outset #fff;background:#c0c0c0}button:active{border-style:inset}
+#screen{background:#000;min-height:420px;display:flex;align-items:center;justify-content:center;overflow:auto}
+#screen canvas{max-width:100%;height:auto}
+.note{padding:8px;font-size:13px}
